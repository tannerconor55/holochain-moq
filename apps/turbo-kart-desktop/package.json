{
  "name": "dev.holochain-moq.turbo-kart",
  "version": "0.1.2",
  "description": "Turbo Kart Rally desktop app (Electron + Holochain, WP10)",
  "homepage": "https://github.com/holochain-moq/holochain-moq",
  "author": "holochain-moq",
  "private": true,
  "license": "CAL-1.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "yarn && yarn fetch:binaries && yarn write:configs",
    "dev": "yarn write:configs && yarn pack:happs && yarn build:sidecar && yarn pouch:unpack && yarn create:icons && sh scripts/with-clean-env.sh electron-vite dev",
    "pack:happs": "node ./scripts/pack-happs.mjs",
    "build:sidecar": "node ./scripts/build-sidecar.mjs",
    "build": "yarn write:configs && yarn pack:happs && yarn build:sidecar && yarn pouch:unpack && yarn create:icons && yarn typecheck && electron-vite build",
    "build:linux": "yarn build && electron-builder --linux deb --config",
    "prepare:win-inputs": "node ./scripts/prepare-windows-inputs.mjs",
    "preflight:win": "node ./scripts/build-windows.mjs --preflight",
    "build:win": "node ./scripts/build-windows.mjs",
    "verify:win-install": "node ./scripts/verify-windows-install.mjs",
    "test:e2e": "yarn build && sh scripts/with-clean-env.sh node scripts/e2e-test.mjs",
    "test:e4": "yarn build && sh scripts/with-clean-env.sh node scripts/e4-test.mjs",
    "test:e5": "yarn build && sh scripts/with-clean-env.sh node scripts/e5-test.mjs",
    "test:lobby-ui": "node --test --test-isolation=none ../../../turbo-kart-rally-main/tests/lobby.test.mjs",
    "test:netplay": "node --test --test-isolation=none ../../../turbo-kart-rally-main/tests/netplay.test.mjs",
    "test:harness": "node --test tests/test-run.test.mjs tests/wayland-outputs.test.mjs tests/evidence.test.mjs",
    "test:progress": "node --test --test-isolation=none ../../../turbo-kart-rally-main/tests/progress.test.mjs",
    "test:content": "node --test --test-isolation=none ../../../turbo-kart-rally-main/tests/content.test.mjs",
    "test:progress-geometry": "sh scripts/with-clean-env.sh node scripts/progress-geometry-test.mjs",
    "test-runs": "node scripts/test-run.mjs",
    "test:single-player": "sh scripts/with-clean-env.sh node scripts/single-player-test.mjs both",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "fetch:binaries": "node ./scripts/fetch-binaries.js",
    "update:binary-hashes": "node ./scripts/update-binary-hashes.mjs",
    "pouch:unpack": "node ./scripts/unpack-pouch.js",
    "create:icons": "node ./scripts/create-icons.js",
    "write:configs": "node ./scripts/write-configs.js",
    "lint": "eslint .",
    "test:e61": "yarn build && sh scripts/with-clean-env.sh node scripts/e61-test.mjs",
    "test:e62": "yarn build && sh scripts/with-clean-env.sh node scripts/e62-test.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@holochain/client": "^0.21.0",
    "@holochain/hc-spin-rust-utils": "0.700.0",
    "@matthme/electron-updater": "6.3.0-alpha.2",
    "@msgpack/msgpack": "^3.1.3",
    "adm-zip": "0.5.18",
    "bufferutil": "4.1.0",
    "commander": "15.0.0",
    "electron-context-menu": "4.1.2",
    "get-port": "7.2.0",
    "js-sha512": "^0.9.0",
    "js-yaml": "4.1.0",
    "nanoid": "5.1.16",
    "semver": "^7.8.5",
    "split": "1.0.1",
    "utf-8-validate": "^6.0.6",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "3.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^16.4.0",
    "jimp": "^1.6.1",
    "make-dir-cli": "^3.1.0",
    "ncp": "^2.0.0",
    "octokit": "4.0.2",
    "png2icons": "2.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.6"
  }
}